# ================= ربات بله =================
BOT_TOKEN=your_bale_bot_token_here

# ================= ادمین =================
ADMIN_ID=your_bale_admin_user_id_here

# ================= API بله =================
# مستقیم یا از طریق واسطه (reverse-proxy)
BALE_API_BASE=https://tapi.bale.ai

# ================= پنل ادمین =================
ADMIN_PANEL_URL=http://localhost:3000
ADMIN_API_BASE=http://localhost:3000/api

# ================= دیتابیس پنل ادمین =================
DATABASE_URL="file:./db/custom.db"

# ================= تنظیمات اختیاری =================
# PROXY_URL=
# BOT_LOG_DIR=logs

# ================= پرداخت کارت‌به‌کارت (card_payment.py) =================
# CARD_PAY_ENABLED=1
# CARD_PAY_DELAY_MINUTES=20          # چند دقیقه پس از فاکتور پرداخت‌نشده، کارت ارسال شود
# CARD_PAY_EXPIRE_HOURS=48
# CARD_PAY_NUMBER=6219861936929354   # پیش‌فرض: CARD_NUMBER
# CARD_PAY_HOLDER=نام صاحب حساب       # پیش‌فرض: ACCOUNT_NAME
# CARD_PAY_BANK=                     # خالی = تشخیص خودکار از شماره کارت
# CARD_PAY_BRAND=خدمات قضایی آنلاین
# CARD_PAY_COPY_MODE=callback        # یا copy_text (دکمهٔ کپی مستقیم، در صورت پشتیبانی بله)
