// This is your Prisma schema file,
// learn more about it at https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Case {
  id              String   @id @default(cuid())
  baleUserId      String
  fullName        String
  serviceType     String   // INQUIRY, LAVAYEH, EZHHARNAMEH, EALAM_VAKALAHT, STAMP_CALC
  status          String   @default("PENDING_PAYMENT") // PENDING_PAYMENT, INCOMPLETE, PROCESSING, READY_TO_SEND, COMPLETED, FAILED, CANCELLED
  
  // Service details
  trackingCode    String?
  documentCategory String?
  subCategory     String?
  branchCode      String?
  branchName      String?
  province        String?
  rowNumber       String?
  archiveNumber   String?
  
  // Person data (JSON array)
  persons         String?  // JSON string
  
  // Content
  title           String?
  textContent     String?
  
  // Financial
  fee             Int      @default(0)
  feeStatus       String   @default("UNPAID") // UNPAID, PAID, MANUAL_APPROVED
  paymentReceiptUrl String?
  paymentApprovedBy String?
  paymentApprovedAt DateTime?
  
  // Results
  resultSummary   String?
  resultData      String?  // JSON - full result from judicial system
  resultAttachmentUrls String? // JSON array of file URLs
  
  // Error tracking
  errorDetails    String?
  errorStep       String?
  lastCompletedStep String?
  
  // Ready to send workflow
  isInReadyToSend Boolean  @default(false)
  readyToSendAt   DateTime?
  sentToUserAt    DateTime?
  sentViaBot      Boolean  @default(false)

  // ⭐ v1.4 — وضعیت امضای الکترونیک (ربات پس از درج موفق امضا true می‌کند)
  hasSignature    Boolean  @default(false)
  signedAt        DateTime?

  // ⭐ v1.3 — شناسه پرداخت سامانه قضایی (استخراج از بخش هزینه توسط ربات)
  paymentId       String?  // شناسه پرداخت ۱۸رقمی سامانه (مثل 140520260315135806)
  systemCost      Int?     // هزینه سامانه قضایی (ریال) — مبنای محاسبه سود

  // ⭐ v1.7 — پیش‌پرداخت (تومان). مبلغی که کاربر قبل از شروع ثبت پرداخت کرده.
  //   طبق قاعدهٔ کارفرما کل این مبلغ مستقیماً «سود» است.
  //   وقتی prepayAmount > 0 باشد، فیلد fee «مابقی» است (کل − پیش‌پرداخت)
  //   و سودِ مرحلهٔ دوم = fee − systemCost (فقط اگر مابقی پرداخت شده باشد).
  prepayAmount    Int      @default(0)
  prepaidAt       DateTime?

  // ⭐ v1.8 — روش پرداخت: null/WALLET (درگاه کیف پول بله) | CARD (کارت‌به‌کارت تاییدشده توسط مدیر)
  paymentMethod   String?
  
  // Timestamps
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  // Relations
  adminActions    AdminAction[]
  activityLogs    ActivityLog[]
  notes           CaseNote[]
}

model AdminAction {
  id              String   @id @default(cuid())
  caseId          String
  case            Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)
  actionType      String   // MANUAL_INTERVENTION, PAYMENT_APPROVAL, PAYMENT_REJECTION, SEND_TO_USER, STATUS_CHANGE
  adminNote       String?
  uploadedFileUrls String?  // JSON array
  sentViaBot      Boolean  @default(false)
  createdAt       DateTime @default(now())
}

model ActivityLog {
  id              String   @id @default(cuid())
  caseId          String?
  case            Case?    @relation(fields: [caseId], references: [id], onDelete: SetNull)
  action          String
  details         String?
  createdAt       DateTime @default(now())
}

model CaseNote {
  id        String   @id @default(cuid())
  caseId    String
  case      Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)
  text      String
  isPinned   Boolean  @default(false)
  createdAt DateTime @default(now())
}

model BotMessage {
  id          String   @id @default(cuid())
  baleUserId  String
  fullName    String?
  messageText String
  fileUrl     String?  // مسیر فایل پیوست شده (public/uploads/...)
  fileName    String?  // نام نمایشی فایل
  status      String   @default("PENDING") // PENDING, SENT, FAILED
  sentAt      DateTime?
  errorDetails String?

  // ⭐ v1.2 — هزینهٔ پیام (فاکتور کیف پول بله) — پیام پس از پرداخت کاربر ارسال می‌شود
  costAmount  Int      @default(0)  // مبلغ هزینه (ریال) — ۰ یعنی بدون هزینه
  costStatus  String   @default("NONE") // NONE (بدون هزینه), AWAITING_PAYMENT (فاکتور ارسال شد), PAID (پرداخت شد)
  paidAt      DateTime?
  paymentId   String?  // شناسه پرداخت بله (telegram_payment_charge_id)

  // ⭐ v1.4 — نوع سند برای شروع خودکار «روند درج امضا» پس از پرداخت کاربر
  // LAVAYEH, EZHHARNAMEH, TAJDID_NAZAR, VAKHAVI, FARQAM, DADKHAST_BEDAVI,
  // SOHL, CHECK_BEDAVI, CHECK_SOHL, INQUIRY — null یعنی بدون امضا (فقط ارسال پیام)
  serviceType  String?
  // مسیر منوی سامانه ثنا برای ناوبری به صفحهٔ امضا — JSON array مثل ["واخواهی"]
  signMenuPath String?
  // کد رهگیری/بایگانی برای جستجوی سند در صفحهٔ امضا (اختیاری)
  trackingCode String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model WorkingHour {
  id         String @id @default(cuid())
  dayOfWeek  Int    // 0=Saturday, 1=Sunday, ..., 6=Friday
  startHour  Int    @default(8)
  startMin   Int    @default(0)
  endHour    Int    @default(22)
  endMin     Int    @default(0)
  enabled    Boolean @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model ExemptUser {
  id         String   @id @default(cuid())
  baleUserId String   @unique
  fullName   String?
  reason     String?
  createdAt  DateTime @default(now())
}

// ⭐ v1.7 — دفتر «مبالغ قابل بازگشت / قابل کسر» کاربران
// مبالغی از پیش‌پرداخت (یا هر پرداخت دیگر) که باید به کاربر برگردد
// یا در پرونده‌های بعدی کاربر کسر شود، با شناسه بله و دلیل ثبت می‌شوند.
model UserCredit {
  id           String    @id @default(cuid())
  baleUserId   String
  fullName     String?
  amount       Int       // مبلغ (تومان)
  kind         String    @default("REFUND") // REFUND (بازگشت به کاربر) | DEDUCT_LATER (کسر در موارد بعدی)
  reason       String    // دلیل ثبت این مبلغ
  status       String    @default("OPEN")   // OPEN (باز) | SETTLED (تسویه‌شده) | CANCELLED (لغو)
  caseId       String?   // پروندهٔ مرتبط (اختیاری)
  trackingCode String?   // کد رهگیری مرتبط (اختیاری)
  source       String    @default("ADMIN")  // ADMIN (ثبت دستی) | BOT (ثبت خودکار ربات)
  settledAt    DateTime?
  settleNote   String?   // توضیح تسویه (مثلاً «در پروندهٔ X کسر شد»)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([baleUserId])
  @@index([status])
}

// ⭐ v1.8 — پرداخت‌های کارت‌به‌کارت (card_payment.py)
// اگر کاربر ۲۰ دقیقه پس از فاکتور بله پرداخت نکند، شماره کارت برایش ارسال
// می‌شود؛ رسید او پس از تایید مدیر (در ربات) همان فلوی پرداخت کیف پول را
// اجرا می‌کند و پرونده (درآمد/سود) مثل پرداخت درگاه به‌روز می‌شود.
// این جدول سابقهٔ رسیدها و وضعیت بررسی را نگه می‌دارد.
model CardPayment {
  id           String    @id @default(cuid())
  externalId   String    @unique            // کد پیگیری کارت‌به‌کارت در ربات
  baleUserId   String
  fullName     String?
  serviceType  String                       // LAVAYEH, CHECK, INQUIRY, ...
  serviceLabel String?                      // نام فارسی نوع درخواست
  invoiceTitle String?
  trackingCode String?
  amount       Int                          // مبلغ فاکتور (تومان)
  paymentKind  String    @default("DIRECT") // PREPAY (پیش‌پرداخت = کل سود) | FINAL (مابقی − هزینهٔ سامانه) | DIRECT (بدون هزینهٔ سامانه)
  status       String    @default("PENDING_REVIEW") // PENDING_REVIEW | APPROVED | REJECTED | PAID_VIA_GATEWAY | EXPIRED
  receiptUrl   String?                      // /uploads/... تصویر رسید
  rejectReason String?
  caseId       String?                      // پروندهٔ مرتبط (پس از تایید، خودکار پیدا می‌شود)
  approvedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([baleUserId])
  @@index([status])
}
